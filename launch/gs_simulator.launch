<?xml version="1.0"?>
<!--
  gs_simulator.launch

  已被 typed TaskFlow 取代,见 scripts/gs_simulator_node.py。
  本 launch 只保留入口,内部是 no-op(便于老 launch 文件不报错)。

  使用方法:
  $ roslaunch multi_uav_strike gs_simulator.launch \
        flow:=ground_search_strike uav_name:=uav0
-->
<launch>
  <arg name="flow" default="" />
  <arg name="uav_name" default="uav0" />

  <!-- typed TaskFlow 由 gs_simulator_node.py 直接发布到 /<uav_ns>/mission/task_flow -->
  <node name="gs_simulator_node"
        pkg="multi_uav_strike"
        type="gs_simulator_node.py"
        output="screen">
    <param name="flow" value="$(arg flow)" />
    <param name="uav_ns" value="$(arg uav_name)" />
  </node>
</launch>
